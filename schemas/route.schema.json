{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/route.schema.json",
  "title": "Domain Route Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain_id", "routes"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "domain_id": { "type": "string" },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "task_types", "signals", "capabilities"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 0 },
          "task_types": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "signals": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
